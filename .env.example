# 复制为 .env 后按需修改；留空表示使用默认值。
# 环境变量优先级高于本文件。

# ── 必填 ──────────────────────────────────────────
# 要监听的 QQ 会话备注名（你在 QQ 里给那个好友/号设置的备注）
QQ_TARGET=你的备注名

# ── DSH 连接 ──────────────────────────────────────
# 运行中的 DSH Web 服务地址
QQ_DSH_URL=http://127.0.0.1:3080
# DSH 端等待回复的最长时间（秒）
QQ_DSH_TIMEOUT=600

# ── 轮询与发送节奏 ────────────────────────────────
# 轮询间隔区间（秒），每次在此区间内随机取值
QQ_POLL_MIN=5
QQ_POLL_MAX=10
# 两条回复之间的最小间隔（秒）
QQ_SEND_GAP_MIN=3
QQ_SEND_GAP_MAX=5
# 每小时最多发送条数
QQ_MAX_SENDS_PER_HOUR=60
# QQ 服务端硬限制：单聊每分钟别超 20 条，超了会被整段限速
QQ_MAX_SENDS_PER_MINUTE=20
# 自己先刹车的位置（留 2 条余量）
QQ_SEND_LIMIT_MARGIN=18
# 单条回复最大字数（超出截断）
QQ_MAX_REPLY_CHARS=1500

# ── 行为开关 ──────────────────────────────────────
# 设为 1 则只读不发送（消息与拟定回复写入日志）
QQ_READ_ONLY=0
# 静默时段，格式 23:00-08:00；留空不启用
QQ_QUIET_HOURS=
# 不抢控制权：默认只看鼠标——键盘在敲不影响，鼠标停下就发。
# 想改回「键鼠都算」设为 any。
QQ_IDLE_SOURCE=mouse
# 最多等多久（秒）；超时则跳过本次回复。设 0 表示一直等。
QQ_TYPE_GUARD_MAX_WAIT=20
# 鼠标静止多少秒算「你停下来了」
QQ_TYPING_IDLE_SEC=3

# ── 秒回手感 ──────────────────────────────────────
# 故意慢一拍的概率（像在忙别的事）
QQ_SLOW_REPLY_PROB=0.05
# 慢一拍时最长延迟（秒）
QQ_SLOW_REPLY_MAX=6

# ── 会话工作目录 ──────────────────────────────────
# QQ 专用 DSH 会话的 cwd，留空则用 ./qq-workspace
QQ_SESSION_CWD=

# ── 说话风格 ──────────────────────────────────────
# 拆条：单条消息最大字数（超出按句切分）
QQ_SPLIT_MAX_CHARS=60
# 拆条后随机只回第一条的概率，模拟"真人在忙"（0 关闭）
QQ_SHORT_REPLY_PROB=0.10

# ── 上下文与成本控制 ──────────────────────────────
# 推理档位：off / low / high / max。聊天建议 low，能明显减少"分析腔"
QQ_REASONING_EFFORT=low

# ── 模型链（主 + 备用，自动故障切换）────────────────
# 格式 provider/model[:effort]，逗号分隔。第一个是主模型。
# 主模型不可用（探测不出字）时自动用下一个；主模型恢复后自动切回。
QQ_MODEL_CHAIN=workbuddy/deepseek-v4.1-flash:low,workbuddy/space-bunny:low,workbuddy/glm-5.3-flash:low
# 探测某个模型能否出字的最长等待（秒）。首次调用冷启动会慢，别设太小
QQ_MODEL_PROBE_TIMEOUT=20
# 探测成功后多久内信任（秒）
QQ_MODEL_HEALTH_OK_TTL=600
# 探测失败后多久再试一次（秒）。过了就用主模型重试，成功即自动切回
QQ_MODEL_HEALTH_FAIL_TTL=600
# 会话轮数上限：超过后自动新建会话并注入摘要，0 表示不限制
QQ_MAX_SESSION_TURNS=40
# 投递时附带多少条历史对话（让模型接得上话）
QQ_CONTEXT_HISTORY=6

# ── 进阶 1：日记 ──────────────────────────────────
# 开关；日记写在 qq-workspace/日记/diary.jsonl，可以 grep、可以手改
QQ_DIARY_ENABLED=1
# 一天最多写几条（别让她打卡，只限上限）
QQ_DIARY_MAX_PER_DAY=3

# ── 进阶 5：主动找人 ──────────────────────────────
QQ_PROACTIVE_ENABLED=1
# 距上一次消息多久之后主动发一条（分钟，区间内随机）
# 每有一条消息往来都会重新计时，所以实际间隔就落在 10~40 分钟
QQ_PROACTIVE_CHECK_MIN=10
QQ_PROACTIVE_CHECK_MAX=40
# 安静多久才算「可以开口」（分钟，正在聊时不打扰）
QQ_PROACTIVE_IDLE_MIN=10
# 到点后真发的概率（1.0 = 到点必发；小于 1 可能拖到下一轮）
QQ_PROACTIVE_PROB=1.0

# ── 进阶 5：印象与图库 ────────────────────────────
QQ_IMPRESSIONS_ENABLED=1
QQ_GALLERY_ENABLED=1
