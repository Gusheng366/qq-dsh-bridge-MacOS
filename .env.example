# 复制为 .env 后按需修改；留空表示使用默认值。
# 环境变量优先级高于本文件。

# ── 必填 ──────────────────────────────────────────
# 要监听的 QQ 会话备注名（你在 QQ 里给那个好友/号设置的备注）
QQ_TARGET=你的备注名

# ── DSH 连接 ──────────────────────────────────────
# 运行中的 DSH Web 服务地址
QQ_DSH_URL=http://127.0.0.1:3080
# DSH 端等待回复的最长时间（秒）
QQ_DSH_TIMEOUT=600

# ── 轮询与发送节奏 ────────────────────────────────
# 轮询间隔区间（秒），每次在此区间内随机取值
QQ_POLL_MIN=5
QQ_POLL_MAX=30
# 两条回复之间的最小间隔（秒）
QQ_SEND_GAP_MIN=3
QQ_SEND_GAP_MAX=8
# 每小时最多发送条数
QQ_MAX_SENDS_PER_HOUR=60
# 单条回复最大字数（超出截断）
QQ_MAX_REPLY_CHARS=1500

# ── 行为开关 ──────────────────────────────────────
# 设为 1 则只读不发送（消息与拟定回复写入日志）
QQ_READ_ONLY=0
# 静默时段，格式 23:00-08:00；留空不启用
QQ_QUIET_HOURS=
# 检测到你在打字时最多等待多久再发送（秒）
QQ_TYPE_GUARD_MAX_WAIT=90

# ── 会话工作目录 ──────────────────────────────────
# QQ 专用 DSH 会话的 cwd，留空则用 ./qq-workspace
QQ_SESSION_CWD=

# ── 说话风格 ──────────────────────────────────────
# 拆条：单条消息最大字数（超出按句切分）
QQ_SPLIT_MAX_CHARS=60
# 拆条后随机只回第一条的概率，模拟"真人在忙"（0 关闭）
QQ_SHORT_REPLY_PROB=0.10

# ── 上下文与成本控制 ──────────────────────────────
# 推理档位：off / low / high / max。聊天建议 low，能明显减少"分析腔"
QQ_REASONING_EFFORT=low
# 会话轮数上限：超过后自动新建会话并注入摘要，0 表示不限制
QQ_MAX_SESSION_TURNS=40
# 投递时附带多少条历史对话（让模型接得上话）
QQ_CONTEXT_HISTORY=6
